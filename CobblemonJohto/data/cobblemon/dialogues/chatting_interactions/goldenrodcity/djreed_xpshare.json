{
    "initializationAction": [
        "q.run_command('tag ' + q.player.username + ' add LuckyNumberCD');"
    ],
  "speakers": {
    "npc": {
      "name": "DJ Reed",
      "face": {
        "type": "artificial",
        "modelType": "npc",
        "identifier": "cobblemon:schoolboy",
        "isLeftSide": true
      }
    }
  },
  "pages": [
    {
      "id": "greeting",
      "speaker": "npc",
      "lines": [
        "Hey! You've matched the last three numbers!"
      ],
      "input": {
        "type": "option",
        "vertical": false,
        "options": [
          {
            "text": "Next",
            "value": "next",
            "action": "q.dialogue.set_page('page2');"
          }
        ]
      }
    },
    {
      "id": "page2",
      "speaker": "npc",
      "lines": [
        "You've won second prize, an Exp.Share!"
      ],
      "input": {
        "type": "option",
        "vertical": false,
        "options": [
          {
            "text": "Next",
            "value": "next",
            "action": [
              "q.run_command('execute as ' + q.player.username + ' run give @s cobblemon:exp_share');",
              "q.run_command('execute as ' + q.player.username + ' run playsound minecraft:entity.experience_orb.pickup ambient @s ~ ~ ~ 1 1 1');",
              "q.dialogue.set_page('page3');"
            ]
          }
        ]
      }
    },
    {
      "id": "page3",
      "speaker": "npc",
      "lines": [
        "Tune in again tomorrow and see me for another chance at a prize!"
      ],
      "input": {
        "type": "option",
        "vertical": false,
        "options": [
          {
            "text": "Close",
            "value": "close",
            "action": "q.dialogue.close();"
          }
        ]
      }
    }
  ]
}