{
    "initializationAction": [
        "c.npc.set_chatting();",
        "q.run_command('scoreboard players set ' + q.player.username + ' BattleEnd 2');",
        "q.run_command('execute as ' + q.player.username + ' run function johto:tools/forceclick');",
        "q.run_command('execute as ' + q.player.username + ' run givetm uturn @s[tag=!Bugsy]');",
        "q.run_command('execute as ' + q.player.username + ' run tag ' + q.player.username + ' add Bugsy');",
        "q.run_command('tellraw ' + q.player.username + ' {\"text\":\"You got $1,800 for winning!\",\"italic\":true,\"color\":\"gray\"}');",
        "q.run_command('scoreboard players add ' + q.player.username + ' Money 1800');"
    ],
    "speakers": {
        "npc": {
            "name": "Bugsy",
            "face": {
                "type": "artificial",
                "modelType": "npc",
                "identifier": "cobblemon:bugsy",
                "isLeftSide": true
            }
        },
        "player": {
            "face": "q.player.face(true);",
            "name": {
                "type": "expression",
                "expression": "q.player.username"
            }
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                "Whoa, amazing! You're an expert on Pokémon! My research isn't complete yet."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
