{
    "initializationAction": [
        "q.run_command('team join battletower ' + q.player.username + '');"
    ],
    "escapeAction": [
        "q.run_command('team join default ' + q.player.username + '');",
        "q.dialogue.close();"
    ],
    "names": [
        "Battle Tower Clerk"
    ],
    "speakers": {
        "npc": {
            "name": "Battle Tower Clerk",
            "face": {
                "type": "artificial",
                "modelType": "npc",
                "identifier": "cobblemon:shopman",
                "isLeftSide": true
            }
        }
    },
